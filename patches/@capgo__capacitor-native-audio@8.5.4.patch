+            self.audioQueue.async {
+                var data = self.audioAssetData[assetId] ?? [:]
+                data["timeBeforePause"] = pin
+                self.audioAssetData[assetId] = data
+                guard let asset = self.audioList[assetId] as? AudioAsset else {
+                    self.remotePauseSettling = false
+                    self.applyRemoteDesiredIfNeeded()
+                    return
+                }
+                if asset.isPlaying() {
+                    asset.pause()
+                }
+                if willSeek {
+                    self.logClock("native.np.freeze.seek", assetId: assetId, player: playerElapsed, duration: duration, extra: [
+                        "from": self.fmtTime(playerElapsed),
+                        "to": self.fmtTime(pin),
+                        "note": "align_player_to_frozen_bar"
+                    ])
+                    asset.setCurrentTime(time: pin, completion: nil)
+                }
+                if reason == "pause" {
+                    self.endSession()
+                }
+                self.notifyPlaybackState(
+                    assetId: assetId,
+                    reason: reason,
+                    state: .paused,
+                    audioAsset: asset,
+                    currentTimeOverride: pin
+                )
+                self.immersiveLog("native.np.freeze.playerPaused", [
+                    "assetId": assetId,
+                    "pin": self.fmtTime(pin),
+                    "reason": reason,
+                    "note": "player_paused_after_np_freeze"
+                ])
+                self.remotePauseSettling = false
+                self.applyRemoteDesiredIfNeeded()
+            }
+        }
+        if Thread.isMainThread {
+            apply()
+        } else {
+            // Never main.sync from audioQueue — Capacitor deadlock.
+            DispatchQueue.main.async(execute: apply)
+        }
+    }
