+    /// Periodically rewrite `elapsed = current visual` with `rate=1` while playing.
+    /// Invisible to the user (bar already there); makes pause `jumpFromSys` ≈ 0.
+    /// Does **not** bump `npWriteGeneration` — freeze/reset cancel us by bumping gen.
+    private func scheduleQuietNowPlayingRebase(
+        assetId: String,
+        generation: UInt64,
+        duration: TimeInterval
+    ) {
+        DispatchQueue.main.asyncAfter(deadline: .now() + npQuietRebaseInterval) { [weak self] in
+            guard let self else { return }
+            guard generation == self.npWriteGeneration else { return }
+            guard self.showNotification, self.lastNpRate > 0 else { return }
+            let stillPlaying = self.audioQueue.sync { () -> (Bool, TimeInterval) in
+                guard self.currentlyPlayingAssetId == assetId,
+                      let asset = self.audioList[assetId] as? AudioAsset,
+                      asset.isPlaying() else { return (false, 0) }
+                return (true, asset.getCurrentTime())
+            }
+            guard stillPlaying.0 else { return }
+
+            let visual = self.nowPlayingVisualElapsed(duration: duration, fallback: stillPlaying.1)
+            let sysInfo = MPNowPlayingInfoCenter.default().nowPlayingInfo
+            let sysElapsed = sysInfo?[MPNowPlayingInfoPropertyElapsedPlaybackTime] as? Double
+            let npAge = self.lastNpWallTime > 0
+                ? (CFAbsoluteTimeGetCurrent() - self.lastNpWallTime) : -1
+            self.logClock("native.np.quietRebase", assetId: assetId, player: stillPlaying.1, duration: duration, extra: [
+                "writeElapsed": self.fmtTime(visual),
+                "writeRate": 1,
+                "npAgeBefore": String(format: "%.3f", npAge),
+                "jumpFromSys": sysElapsed.map { String(format: "%+.4f", visual - $0) } ?? "nil",
+                "note": "rebase_dict_to_visual_keep_rate1"
+            ])
+            var info = MPNowPlayingInfoCenter.default().nowPlayingInfo ?? [String: Any]()
+            if duration.isFinite && duration > 0 {
+                info[MPMediaItemPropertyPlaybackDuration] = duration
+            }
+            info[MPNowPlayingInfoPropertyElapsedPlaybackTime] = visual
+            info[MPNowPlayingInfoPropertyPlaybackRate] = 1.0
+            MPNowPlayingInfoCenter.default().nowPlayingInfo = info
+            self.noteNowPlayingClock(elapsed: visual, rate: 1, reason: "quietRebase")
+            self.scheduleQuietNowPlayingRebase(
+                assetId: assetId,
+                generation: generation,
+                duration: duration
+            )
+        }
