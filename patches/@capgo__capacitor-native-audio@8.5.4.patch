+    private func scheduleArmPlayingRate(
+        assetId: String,
+        generation: UInt64,
+        attempt: Int,
+        resumePin: TimeInterval?
+    ) {
+        // Resume seek can take longer than cold start; don't force rate=1 early.
+        let maxAttempts = resumePin != nil ? 30 : 10 // ~480ms / ~160ms
+        let startThreshold: TimeInterval = 0.015
+        audioQueue.asyncAfter(deadline: .now() + 0.016) { [weak self] in
+            guard let self else { return }
+            guard generation == self.npWriteGeneration else { return }
+            guard self.showNotification,
+                  self.currentlyPlayingAssetId == assetId,
+                  let asset = self.audioList[assetId] as? AudioAsset,
+                  asset.isPlaying() else { return }
+
+            let t = asset.getCurrentTime()
+            let duration = asset.getDuration()
+            let ready: Bool
+            if let pin = resumePin {
+                // Seek/resume landed — player is at (or past) the freeze pin.
+                ready = t >= pin - 0.02 || attempt >= maxAttempts
+            } else {
+                ready = t >= startThreshold || attempt >= maxAttempts
+            }
+            if ready {
+                // Never arm behind the held pin (would flash the scrubber backward).
+                let armElapsed: TimeInterval
+                if let pin = resumePin {
+                    armElapsed = max(t, pin)
+                } else {
+                    armElapsed = t
+                }
+                self.applyPlayingNowPlayingRate1(
+                    assetId: assetId,
+                    elapsed: max(0, armElapsed),
+                    duration: duration,
+                    generation: generation,
+                    attempt: attempt,
+                    resumePinFloor: resumePin
+                )
+            } else {
+                self.scheduleArmPlayingRate(
+                    assetId: assetId,
+                    generation: generation,
+                    attempt: attempt + 1,
+                    resumePin: resumePin
+                )
+            }
+        }
+    }
+
+    private func applyPlayingNowPlayingRate1(
+        assetId: String,
+        elapsed: TimeInterval,
+        duration: TimeInterval,
+        generation: UInt64,
+        attempt: Int,
+        resumePinFloor: TimeInterval?
+    ) {
+        let apply: () -> Void = { [weak self] in
+            guard let self else { return }
+            guard generation == self.npWriteGeneration else {
+                print("[MANYU_IMMERSIVE] native.np.arm.dropStale gen=\(generation) current=\(self.npWriteGeneration)")
+                return
+            }
+            // Re-sample at the write instant (cold start). Resume must NOT arm at live:
+            // hold freezes the bar at pin, then audio runs a few frames — live > pin —
+            // writing live+rate=1 flashes the scrubber forward ("很快闪到后面").
+            let live = self.audioQueue.sync { () -> TimeInterval in
+                guard self.currentlyPlayingAssetId == assetId,
+                      let asset = self.audioList[assetId] as? AudioAsset,
+                      asset.isPlaying() else { return elapsed }
+                return asset.getCurrentTime()
+            }
+            var pinned: TimeInterval
+            if let floor = resumePinFloor {
+                pinned = max(0, floor)
+            } else {
+                pinned = max(0, live)
+            }
+            if duration.isFinite && duration > 0 {
+                pinned = min(duration, pinned)
+            }
+            self.logClock("native.np.arm", assetId: assetId, player: live, duration: duration, extra: [
+                "polled": self.fmtTime(elapsed),
+                "live": self.fmtTime(live),
+                "floor": resumePinFloor.map { self.fmtTime($0) } ?? "nil",
+                "writeElapsed": self.fmtTime(pinned),
+                "writeRate": 1,
+                "attempt": attempt,
+                "note": resumePinFloor != nil
+                    ? "resume_arm_at_hold_pin_not_live"
+                    : "wall_clock_starts_here_with_live_player"
+            ])
+            var info = MPNowPlayingInfoCenter.default().nowPlayingInfo ?? [String: Any]()
+            info[MPNowPlayingInfoPropertyElapsedPlaybackTime] = pinned
+            info[MPNowPlayingInfoPropertyPlaybackRate] = 1.0
+            if duration.isFinite && duration > 0 {
+                info[MPMediaItemPropertyPlaybackDuration] = duration
+            }
+            MPNowPlayingInfoCenter.default().nowPlayingInfo = info
+            self.setNowPlayingPlaybackState(playing: true)
+            self.noteNowPlayingClock(elapsed: pinned, rate: 1, reason: "armRate1")
+            // Keep dictionary elapsed ≈ displayed bar for the rest of the track.
+            self.scheduleQuietNowPlayingRebase(
+                assetId: assetId,
+                generation: generation,
+                duration: duration
+            )
+            if resumePinFloor != nil {
+                self.remoteResumeSettling = false
+                self.applyRemoteDesiredIfNeeded()
+            }
+        }
+        if Thread.isMainThread {
+            apply()
+        } else {
+            DispatchQueue.main.async(execute: apply)
+        }
+    }
