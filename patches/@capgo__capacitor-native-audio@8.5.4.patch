index 0000000000000000000000000000000000000000..e83e4422363ad0361e2594252c479bed20e2b190
--- /dev/null
+++ b/ios/Sources/NativeAudioPlugin/NowPlayingClock.swift
@@ -0,0 +1,611 @@
+import Foundation
+import MediaPlayer
+import UIKit
+
+/// Single writer for iOS Now Playing elapsed + playbackRate.
+///
+/// All scrubber updates go through `commit`. Plugin / Queue only send intents.
+/// Visual clock (`anchorElapsed + rate * age`) is authoritative while rate > 0;
+/// AVAudioPlayer.currentTime is only used to seed `armPlaying` and to ignore EOT rewind.
+final class NowPlayingClock {
+    enum State: String {
+        case idle
+        case armed
+        case holding
+        case playing
+        case frozen
+        case ended
+    }
+
+    enum BeginTrackPolicy: CustomStringConvertible {
+        /// Replace card with new title/duration at elapsed=0 (setQueue / remote skip).
+        /// Wipes MPNowPlayingInfo first — can blink the whole lock-screen card.
+        case replaceAtZero
+        /// Same as replaceAtZero but updates the existing info dict in place.
+        /// Used for gap / trailing pre-arm so end→0 does not blank the card.
+        case replaceAtZeroInPlace
+        /// Keep previous ended card until armPlaying (same-title segment next).
+        case keepEndedUntilArm
+
+        var description: String {
+            switch self {
+            case .replaceAtZero: return "replaceAtZero"
+            case .replaceAtZeroInPlace: return "replaceAtZeroInPlace"
+            case .keepEndedUntilArm: return "keepEndedUntilArm"
+            }
+        }
+    }
+
+    struct Meta {
+        var title: String?
+        var artist: String?
+        var album: String?
+        var artwork: UIImage?
+    }
+
+    private(set) var state: State = .idle
+    private(set) var generation: UInt64 = 0
+    private(set) var assetId: String?
+    private(set) var duration: TimeInterval = 0
+    private(set) var lastElapsed: TimeInterval = 0
+    private(set) var lastRate: Double = 0
+    private(set) var lastWallTime: CFAbsoluteTime = 0
+    /// Active playback rate for wall-clock (setRate).
+    var playingRate: Double = 1.0
+
+    private let tickInterval: TimeInterval = 0.1
+    private var tickScheduled = false
+    /// Optional sample of player time while playing (for EOT rewind detection).
+    var playerTimeSample: (() -> (playing: Bool, time: TimeInterval))?
+    /// Stashed by `keepEndedUntilArm` — applied atomically in `armPlaying`.
+    private var pendingArmDuration: TimeInterval?
+    private var pendingArmReplaceCard = false
+
+    private func bumpGeneration() -> UInt64 {
+        generation += 1
+        return generation
+    }
+
+    private func effectivePlayingRate() -> Double {
+        let rate = playingRate
+        if rate.isFinite && rate > 0.01 { return rate }
+        return 1.0
+    }
+
+    /// What Control Center is interpolating right now.
+    func visualElapsed(fallback: TimeInterval? = nil) -> TimeInterval {
+        let fb = fallback ?? lastElapsed
+        guard lastRate > 0, lastWallTime > 0 else { return max(0, fb) }
+        let visual = lastElapsed + lastRate * (CFAbsoluteTimeGetCurrent() - lastWallTime)
+        let capped = (duration.isFinite && duration > 0) ? min(duration, visual) : visual
+        return max(0, capped)
+    }
+
+    // MARK: - Single commit (ONLY writer of elapsed/rate)
+
+    @discardableResult
+    private func commit(
+        elapsed: TimeInterval,
+        rate: Double,
+        duration newDuration: TimeInterval? = nil,
+        metadata: Meta? = nil,
+        glyphPlaying: Bool?,
+        reason: String,
+        replaceCard: Bool = false,
+        to toState: State? = nil
+    ) -> UInt64 {
+        let from = state
+        if let toState {
+            state = toState
+        }
+        let gen = bumpGeneration()
+        var elapsedPinned = max(0, elapsed)
+        if let d = newDuration, d.isFinite, d > 0 {
+            duration = d
+        }
+        if duration.isFinite && duration > 0 {
+            elapsedPinned = min(duration, elapsedPinned)
+        }
+
+        let to = state
+        let apply: () -> Void = { [weak self] in
+            guard let self else { return }
+            guard gen == self.generation else {
+                print("[MANYU_IMMERSIVE] native.np.commit.dropStale gen=\(gen) current=\(self.generation) reason=\(reason)")
+                return
+            }
+
+            var info: [String: Any]
+            if replaceCard {
+                info = [String: Any]()
+            } else {
+                info = MPNowPlayingInfoCenter.default().nowPlayingInfo ?? [String: Any]()
+            }
+
+            if let metadata {
+                if let title = metadata.title { info[MPMediaItemPropertyTitle] = title }
+                if let artist = metadata.artist { info[MPMediaItemPropertyArtist] = artist }
+                if let album = metadata.album { info[MPMediaItemPropertyAlbumTitle] = album }
+                if let image = metadata.artwork {
+                    info[MPMediaItemPropertyArtwork] = MPMediaItemArtwork(boundsSize: image.size) { _ in image }
+                }
+            }
+
+            if self.duration.isFinite && self.duration > 0 {
+                info[MPMediaItemPropertyPlaybackDuration] = self.duration
+            }
+            info[MPNowPlayingInfoPropertyElapsedPlaybackTime] = elapsedPinned
+            info[MPNowPlayingInfoPropertyPlaybackRate] = rate
+            MPNowPlayingInfoCenter.default().nowPlayingInfo = info
+
+            if let glyph = glyphPlaying, #available(iOS 13.0, *) {
+                MPNowPlayingInfoCenter.default().playbackState = glyph ? .playing : .paused
+            }
+
+            self.lastElapsed = elapsedPinned
+            self.lastRate = rate
+            self.lastWallTime = CFAbsoluteTimeGetCurrent()
+
+            print(
+                "[MANYU_IMMERSIVE] native.np.commit reason=\(reason) from=\(from.rawValue) to=\(to.rawValue) " +
+                "assetId=\(self.assetId ?? "nil") elapsed=\(String(format: "%.4f", elapsedPinned)) " +
+                "rate=\(rate) duration=\(String(format: "%.4f", self.duration)) gen=\(gen)"
+            )
+        }
+
+        if Thread.isMainThread {
+            apply()
+        } else {
+            DispatchQueue.main.async(execute: apply)
+        }
+        return gen
+    }
+
+    // MARK: - Intents
+
+    /// Paused card before any play (setQueue autoPlay:false).
+    @discardableResult
+    func showArmed(assetId: String, duration: TimeInterval, metadata: Meta, elapsed: TimeInterval = 0) -> UInt64 {
+        stopTick()
+        self.assetId = assetId
+        return commit(
+            elapsed: elapsed,
+            rate: 0,
+            duration: duration,
+            metadata: metadata,
+            glyphPlaying: false,
+            reason: "showArmed",
+            replaceCard: true,
+            to: .armed
+        )
+    }
+
+    /// Start of a track switch. Returns generation for later armPlaying.
+    @discardableResult
+    func beginTrack(
+        assetId: String,
+        duration: TimeInterval,
+        metadata: Meta,
+        policy: BeginTrackPolicy,
+        reason: String
+    ) -> UInt64 {
+        stopTick()
+        self.assetId = assetId
+        switch policy {
+        case .replaceAtZero, .replaceAtZeroInPlace:
+            let wipe = policy == .replaceAtZero
+            return commit(
+                elapsed: 0,
+                rate: 0,
+                duration: duration,
+                metadata: metadata,
+                glyphPlaying: true,
+                reason: "beginTrack.\(policy).\(reason)",
+                replaceCard: wipe,
+                to: .holding
+            )
+        case .keepEndedUntilArm:
+            // Do NOT write @0 and do NOT touch the system dictionary. Keep the previous
+            // ended pin on screen until armPlaying publishes the new card in one commit.
+            // (Previously this zeroed lastElapsed + swapped duration early → flash to front.)
+            let gen = bumpGeneration()
+            state = .holding
+            lastRate = 0
+            lastWallTime = CFAbsoluteTimeGetCurrent()
+            pendingArmDuration = duration
+            // New learning item / title change: replace card on arm. Segment next too —
+            // one atomic jump from previous end → new live elapsed (no intermediate @0).
+            pendingArmReplaceCard = true
+            print(
+                "[MANYU_IMMERSIVE] native.np.commit reason=beginTrack.keepEndedUntilArm.\(reason) " +
+                "from=ended to=holding assetId=\(assetId) elapsed=keep " +
+                "keepElapsed=\(String(format: "%.4f", lastElapsed)) " +
+                "pendingDuration=\(String(format: "%.4f", duration)) gen=\(gen)"
+            )
+            return gen
+        }
+    }
+
+    /// First rate>0 write. Fresh content play must arm @0 (per-clip card), never catch-up to live t.
+    /// If the card is already holding @0 (gap pre-arm), only flip rate — no elapsed rewrite.
+    @discardableResult
+    func armPlaying(
+        liveElapsed: TimeInterval,
+        metadata: Meta? = nil,
+        resumePinFloor: TimeInterval? = nil
+    ) -> UInt64 {
+        stopTick()
+        let replaceCard = pendingArmReplaceCard
+        pendingArmReplaceCard = false
+        let armDuration = pendingArmDuration
+        pendingArmDuration = nil
+        if let armDuration, armDuration.isFinite, armDuration > 0 {
+            duration = armDuration
+        }
+        var pinned: TimeInterval
+        if let floor = resumePinFloor {
+            pinned = max(0, floor)
+        } else {
+            pinned = max(0, liveElapsed)
+        }
+        if duration.isFinite && duration > 0 {
+            pinned = min(duration, pinned)
+        }
+        // Gap already published this card @0: only start the clock (no scrubber jump).
+        let alreadyAtZero = (state == .holding || state == .armed)
+            && lastElapsed <= 0.02
+            && pinned <= 0.02
+            && !replaceCard
+        let armReason: String
+        if alreadyAtZero {
+            armReason = "armPlaying.rateOnly"
+        } else if let floor = resumePinFloor, floor <= 0, pinned <= 0 {
+            armReason = "armPlaying.atZero"
+        } else if resumePinFloor != nil {
+            armReason = "armPlaying.resumePin"
+        } else {
+            armReason = "armPlaying.live"
+        }
+        let gen = commit(
+            elapsed: alreadyAtZero ? 0 : pinned,
+            rate: effectivePlayingRate(),
+            duration: alreadyAtZero ? nil : armDuration,
+            metadata: alreadyAtZero ? nil : metadata,
+            glyphPlaying: true,
+            reason: armReason,
+            replaceCard: alreadyAtZero ? false : replaceCard,
+            to: .playing
+        )
+        startTick()
+        return gen
+    }
+
+    /// Resume: rate at pin first, then caller starts audio.
+    @discardableResult
+    func resume(pin: TimeInterval) -> UInt64 {
+        stopTick()
+        var pinned = max(0, pin)
+        if duration.isFinite && duration > 0 {
+            pinned = min(duration, pinned)
+        }
+        let gen = commit(
+            elapsed: pinned,
+            rate: effectivePlayingRate(),
+            glyphPlaying: true,
+            reason: "resume",
+            to: .playing
+        )
+        startTick()
+        return gen
+    }
+
+    /// Pause: freeze the scrubber where it already is (visual). Never pull it back to
+    /// the player — that caused the "pause jumps backward" regression. Do not seek the
+    /// player forward on pause either; resume may catch audio up to the frozen pin.
+    @discardableResult
+    func pause(playerElapsed: TimeInterval) -> (gen: UInt64, pin: TimeInterval, willSeek: Bool) {
+        stopTick()
+        let visual = visualElapsed(fallback: max(lastElapsed, playerElapsed))
+        // Prefer the higher of last committed / visual so we never rewind the bar.
+        var pin = max(lastElapsed, visual)
+        // If player is slightly ahead of visual, meet it (no backward jump).
+        if playerElapsed > pin {
+            pin = playerElapsed
+        }
+        let pinClamped: TimeInterval
+        if duration.isFinite && duration > 0 {
+            pinClamped = min(duration, max(0, pin))
+        } else {
+            pinClamped = max(0, pin)
+        }
+
+        // Never seek on pause. Forward catch-up (if any) happens on resume.
+        let willSeek = false
+        _ = playerElapsed
+
+        let gen = commit(
+            elapsed: pinClamped,
+            rate: 0,
+            glyphPlaying: false,
+            reason: "pause.freeze",
+            to: .frozen
+        )
+        return (gen, pinClamped, willSeek)
+    }
+
+    /// Track complete: pin to this clip's duration.
+    @discardableResult
+    func complete(durationOverride: TimeInterval? = nil, keepPlayingGlyph: Bool) -> UInt64 {
+        stopTick()
+        if let d = durationOverride, d.isFinite, d > 0 {
+            duration = d
+        }
+        let pin: TimeInterval
+        if duration.isFinite && duration > 0 {
+            pin = duration
+        } else {
+            pin = max(lastElapsed, visualElapsed())
+        }
+        // Sync pin immediately so a racing reader/tick cannot observe player≈0 as elapsed
+        // before the main-queue dictionary commit lands.
+        lastElapsed = pin
+        lastRate = 0
+        lastWallTime = CFAbsoluteTimeGetCurrent()
+        pendingArmDuration = nil
+        pendingArmReplaceCard = false
+        return commit(
+            elapsed: pin,
+            rate: 0,
+            glyphPlaying: keepPlayingGlyph,
+            reason: "complete",
+            to: .ended
+        )
+    }
+
+    /// Rate change while playing — rebase near the player so wall-clock cannot race ahead.
+    @discardableResult
+    func setRate(_ rate: Double) -> UInt64? {
+        playingRate = rate
+        guard state == .playing, lastRate > 0 else {
+            print("[MANYU_IMMERSIVE] native.np.commit reason=setRate.skip state=\(state.rawValue) note=await_arm")
+            return nil
+        }
+        var elapsed = visualElapsed()
+        if let sample = playerTimeSample?() {
+            let nearEnd = duration.isFinite && duration > 0
+                && max(elapsed, lastElapsed) > max(0.15, duration * 0.35)
+            // EOT: AVAudioPlayer rewinds to ≈0 before complete() pins duration.
+            // Writing that 0 here is the "闪到前面 → 又闪回100%" flash.
+            if nearEnd && sample.time < 0.08 {
+                elapsed = duration
+                print("[MANYU_IMMERSIVE] native.np.setRate.eotPin elapsed=\(String(format: "%.4f", elapsed)) note=ignore_player_rewind")
+            } else if sample.playing {
+                let maxLead: TimeInterval = 0.05
+                elapsed = max(sample.time, min(elapsed, sample.time + maxLead))
+                if duration.isFinite && duration > 0 {
+                    elapsed = min(duration, elapsed)
+                }
+            }
+        }
+        let gen = commit(
+            elapsed: elapsed,
+            rate: effectivePlayingRate(),
+            glyphPlaying: true,
+            reason: "setRate",
+            to: .playing
+        )
+        startTick()
+        return gen
+    }
+
+    /// Scrubber seek — update elapsed without changing play/pause intent.
+    /// Caller seeks AVAudioPlayer; this only updates the Now Playing dictionary + pin baseline.
+    @discardableResult
+    func seek(to elapsed: TimeInterval, playing: Bool) -> UInt64 {
+        stopTick()
+        var pinned = max(0, elapsed)
+        if duration.isFinite && duration > 0 {
+            pinned = min(duration, pinned)
+        }
+        if playing {
+            let gen = commit(
+                elapsed: pinned,
+                rate: effectivePlayingRate(),
+                glyphPlaying: true,
+                reason: "seek.playing",
+                to: .playing
+            )
+            startTick()
+            return gen
+        }
+        let toState: State = (state == .armed) ? .armed : .frozen
+        return commit(
+            elapsed: pinned,
+            rate: 0,
+            glyphPlaying: false,
+            reason: "seek.paused",
+            to: toState
+        )
+    }
+
+    /// Artwork only — never change elapsed/rate (re-use last committed values).
+    func mergeArtwork(_ image: UIImage, forAssetId expectedId: String) {
+        guard assetId == expectedId else { return }
+        let gen = generation
+        let elapsed = lastElapsed
+        let rate = lastRate
+        let dur = duration
+        let apply: () -> Void = {
+            guard gen == self.generation else { return }
+            var info = MPNowPlayingInfoCenter.default().nowPlayingInfo ?? [String: Any]()
+            info[MPMediaItemPropertyArtwork] = MPMediaItemArtwork(boundsSize: image.size) { _ in image }
+            // Keep same elapsed/rate so iOS does not restart from a drifted visual.
+            info[MPNowPlayingInfoPropertyElapsedPlaybackTime] = elapsed
+            info[MPNowPlayingInfoPropertyPlaybackRate] = rate
+            if dur.isFinite && dur > 0 {
+                info[MPMediaItemPropertyPlaybackDuration] = dur
+            }
+            MPNowPlayingInfoCenter.default().nowPlayingInfo = info
+            print(
+                "[MANYU_IMMERSIVE] native.np.commit reason=artworkOnly assetId=\(expectedId) " +
+                "elapsed=\(String(format: "%.4f", elapsed)) rate=\(rate) gen=\(gen)"
+            )
+        }
+        if Thread.isMainThread {
+            apply()
+        } else {
+            DispatchQueue.main.async(execute: apply)
+        }
+    }
+
+    /// Bump generation to drop in-flight arm/tick without rewriting the card.
+    @discardableResult
+    func cancelPending(reason: String) -> UInt64 {
+        stopTick()
+        let gen = bumpGeneration()
+        print("[MANYU_IMMERSIVE] native.np.commit reason=cancelPending.\(reason) state=\(state.rawValue) gen=\(gen)")
+        return gen
+    }
+
+    func clear() {
+        stopTick()
+        let gen = bumpGeneration()
+        state = .idle
+        assetId = nil
+        duration = 0
+        lastElapsed = 0
+        lastRate = 0
+        lastWallTime = CFAbsoluteTimeGetCurrent()
+        DispatchQueue.main.async {
+            if #available(iOS 13.0, *) {
+                MPNowPlayingInfoCenter.default().playbackState = .stopped
+            }
+            MPNowPlayingInfoCenter.default().nowPlayingInfo = nil
+            print("[MANYU_IMMERSIVE] native.np.commit reason=clear gen=\(gen)")
+        }
+    }
+
+    /// Generic elapsed/rate patch for fade/stop leftovers — routes through commit.
+    @discardableResult
+    func patchPlayback(isPlaying: Bool, elapsed: TimeInterval?, duration newDuration: TimeInterval?) -> UInt64 {
+        stopTick()
+        if let d = newDuration, d.isFinite, d > 0 {
+            duration = d
+        }
+        let el = elapsed ?? lastElapsed
+        if isPlaying {
+            let gen = commit(
+                elapsed: el,
+                rate: effectivePlayingRate(),
+                glyphPlaying: true,
+                reason: "patch.playing",
+                to: .playing
+            )
+            startTick()
+            return gen
+        } else {
+            return commit(
+                elapsed: el,
+                rate: 0,
+                glyphPlaying: false,
+                reason: "patch.paused",
+                to: .frozen
+            )
+        }
+    }
+
+    // MARK: - Tick (quiet rebase owned by clock)
+
+    private func startTick() {
+        tickScheduled = true
+        let gen = generation
+        let trackedId = assetId
+        DispatchQueue.main.asyncAfter(deadline: .now() + tickInterval) { [weak self] in
+            self?.tick(expectedGen: gen, expectedAssetId: trackedId)
+        }
+    }
+
+    private func stopTick() {
+        tickScheduled = false
+    }
+
+    private func tick(expectedGen: UInt64, expectedAssetId: String?) {
+        guard tickScheduled else { return }
+        guard expectedGen == generation, state == .playing, lastRate > 0 else { return }
+        guard assetId == expectedAssetId else { return }
+
+        var writeElapsed = visualElapsed()
+        var writeRate = effectivePlayingRate()
+        var stopAfterWrite = false
+        if let sample = playerTimeSample?() {
+            let nearEnd = duration.isFinite && duration > 0
+                && max(writeElapsed, lastElapsed) > max(0.15, duration * 0.35)
+            // EOT: player rewinds to ≈0 (and often isPlaying=false) before complete().
+            // Pin duration + rate=0 immediately — do NOT return early with rate still 1,
+            // and never publish player≈0 (that is 闪到前面 → complete 再闪回100%).
+            if nearEnd && (sample.time < 0.08 || !sample.playing) {
+                writeElapsed = duration
+                writeRate = 0
+                stopAfterWrite = true
+                print(
+                    "[MANYU_IMMERSIVE] native.np.tick.eotPin assetId=\(assetId ?? "nil") " +
+                    "elapsed=\(String(format: "%.4f", writeElapsed)) player=\(String(format: "%.4f", sample.time)) " +
+                    "playing=\(sample.playing)"
+                )
+            } else if !sample.playing {
+                // Mid-track pause/stop — complete/pause intent owns the next write.
+                return
+            } else {
+                // Keep visual near player for all clip lengths — wall clock races ahead
+                // otherwise, and pause used to snap back (往回闪).
+                let maxLead: TimeInterval = 0.05
+                writeElapsed = max(sample.time, min(writeElapsed, sample.time + maxLead))
+                if duration.isFinite && duration > 0 {
+                    writeElapsed = min(duration, writeElapsed)
+                }
+            }
+        }
+
+        // Tick does NOT bump generation — pause/complete cancel by bumping.
+        var info = MPNowPlayingInfoCenter.default().nowPlayingInfo ?? [String: Any]()
+        if duration.isFinite && duration > 0 {
+            info[MPMediaItemPropertyPlaybackDuration] = duration
+        }
+        info[MPNowPlayingInfoPropertyElapsedPlaybackTime] = writeElapsed
+        info[MPNowPlayingInfoPropertyPlaybackRate] = writeRate
+        MPNowPlayingInfoCenter.default().nowPlayingInfo = info
+        lastElapsed = writeElapsed
+        lastRate = writeRate
+        lastWallTime = CFAbsoluteTimeGetCurrent()
+        print(
+            "[MANYU_IMMERSIVE] native.np.commit reason=tick assetId=\(assetId ?? "nil") " +
+            "elapsed=\(String(format: "%.4f", writeElapsed)) rate=\(writeRate) gen=\(generation)"
+        )
+
+        if stopAfterWrite {
+            // Stay in playing until complete() flips to ended; just stop interpolating.
+            tickScheduled = false
+            return
+        }
+
+        let nextGen = generation
+        let nextId = assetId
+        DispatchQueue.main.asyncAfter(deadline: .now() + tickInterval) { [weak self] in
+            self?.tick(expectedGen: nextGen, expectedAssetId: nextId)
+        }
+    }
+}
+
+extension NowPlayingClock {
+    static func meta(
+        from map: [String: String]?,
+        artwork: UIImage?
+    ) -> Meta {
+        Meta(
+            title: map?["title"],
+            artist: map?["artist"],
+            album: map?["album"],
+            artwork: artwork
+        )
+    }
+}
