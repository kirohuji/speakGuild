+            let jumpFromSys = sysElapsed.map { pin - $0 }
+            self.logClock("native.np.freeze", assetId: assetId, player: playerElapsed, duration: duration, extra: [
+                "pin": self.fmtTime(pin),
+                "pinSource": pinSource,
+                "staleClock": staleClock,
+                "endLag": endLag,
+                "deltaPinPlayer": String(format: "%+.4f", delta),
+                "willSeek": willSeek,
+                "writeRate": 0,
+                "sysElapsed": sysElapsed.map { self.fmtTime($0) } ?? "nil",
+                "sysRate": sysRate.map { String(describing: $0) } ?? "nil",
+                "jumpFromSys": jumpFromSys.map { String(format: "%+.4f", $0) } ?? "nil",
+                "note": "bridge_then_freeze_before_player_pause",
+                "gen": gen
+            ])
+
+            // Bridge then rate=0 in the same turn. Yielding here made rapid play/pause race
+            // (player still "playing" → play ignored → later pause lands → scrubber thrash).
+            // 0.1s quiet rebase keeps jumpFromSys small enough that sync rate=0 is fine.
