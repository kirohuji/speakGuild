+    /// After pause→play when seek already landed: write `rate=1` @ pin, **then** resume audio.
+    /// Avoids hold-while-playing (audio runs ahead → scrubber flashes forward on arm / rebase).
+    internal func publishResumeArmThenPlay(
+        assetId: String,
+        pinnedElapsed: TimeInterval,
+        duration: TimeInterval,
+        asset: AudioAsset,
+        reason: String
+    ) {
+        npWriteGeneration += 1
+        let gen = npWriteGeneration
+        var pin = max(0, pinnedElapsed)
+        if duration.isFinite && duration > 0 {
+            pin = min(duration, pin)
+        }
+        let applyArm: () -> Void = { [weak self] in
+            guard let self else { return }
+            guard gen == self.npWriteGeneration else {
+                print("[MANYU_IMMERSIVE] native.np.resumeArm.dropStale gen=\(gen) current=\(self.npWriteGeneration)")
+                return
+            }
+            self.logClock("native.np.resumeArm", assetId: assetId, player: pin, duration: duration, extra: [
+                "writeElapsed": self.fmtTime(pin),
+                "writeRate": 1,
+                "note": "rate1_at_pin_before_audio_resume"
+            ])
+            var info = MPNowPlayingInfoCenter.default().nowPlayingInfo ?? [String: Any]()
+            info[MPNowPlayingInfoPropertyElapsedPlaybackTime] = pin
+            info[MPNowPlayingInfoPropertyPlaybackRate] = 1.0
+            if duration.isFinite && duration > 0 {
+                info[MPMediaItemPropertyPlaybackDuration] = duration
+            }
+            MPNowPlayingInfoCenter.default().nowPlayingInfo = info
+            self.setNowPlayingPlaybackState(playing: true)
+            self.noteNowPlayingClock(elapsed: pin, rate: 1, reason: "resumeArm")
+            self.scheduleQuietNowPlayingRebase(
+                assetId: assetId,
+                generation: gen,
+                duration: duration
+            )
+            self.audioQueue.async {
+                if self.remoteDesiredPlaying == false {
+                    self.remoteResumeSettling = false
+                    self.immersiveLog("native.remote.resume.abort", [
+                        "assetId": assetId,
+                        "note": "desired_paused_before_audio_resume"
+                    ])
+                    self.applyRemoteDesiredIfNeeded()
+                    return
+                }
+                asset.resume()
+                self.remoteResumeSettling = false
+                self.notifyPlaybackState(
+                    assetId: assetId,
+                    reason: reason,
+                    state: .playing,
+                    audioAsset: asset,
+                    currentTimeOverride: pin
+                )
+                self.applyRemoteDesiredIfNeeded()
+            }
+        }
+        if Thread.isMainThread {
+            applyArm()
+        } else {
+            DispatchQueue.main.async(execute: applyArm)
+        }
+    }
