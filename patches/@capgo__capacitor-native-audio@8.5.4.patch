+    /// Where the lock-screen bar is right now (iOS interpolates when rate=1).
+    internal func nowPlayingVisualElapsed(duration: TimeInterval, fallback: TimeInterval) -> TimeInterval {
+        guard lastNpRate > 0, lastNpWallTime > 0 else { return fallback }
+        let visual = lastNpElapsed + lastNpRate * (CFAbsoluteTimeGetCurrent() - lastNpWallTime)
+        let capped = (duration.isFinite && duration > 0) ? min(duration, visual) : visual
+        return max(0, capped)
+    }
