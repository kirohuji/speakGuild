+    /// Reset locals sync when switching tracks. NP dictionary write is ALWAYS async —
+    /// `main.sync` from `audioQueue` deadlocks Capacitor (JS on main → audioQueue.sync → main.sync).
+    internal func resetNowPlayingClockForNewTrack(assetId: String) {
+        npWriteGeneration += 1
+        let gen = npWriteGeneration
+        noteNowPlayingClock(elapsed: 0, rate: 0, reason: "clockReset")
+        self.immersiveLog("native.np.clockReset", [
+            "assetId": assetId,
+            "gen": gen,
+            "note": "track_switch_zero_both_clocks"
+        ])
+        let apply: () -> Void = { [weak self] in
+            guard let self else { return }
+            guard gen == self.npWriteGeneration else { return }
+            var info = MPNowPlayingInfoCenter.default().nowPlayingInfo ?? [String: Any]()
+            info[MPNowPlayingInfoPropertyElapsedPlaybackTime] = 0.0
+            info[MPNowPlayingInfoPropertyPlaybackRate] = 0.0
+            MPNowPlayingInfoCenter.default().nowPlayingInfo = info
+        }
+        if Thread.isMainThread {
+            apply()
+        } else {
+            DispatchQueue.main.async(execute: apply)
+        }
+    }
