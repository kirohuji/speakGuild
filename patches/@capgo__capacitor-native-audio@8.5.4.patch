+    internal func noteNowPlayingClock(elapsed: TimeInterval, rate: Double, reason: String? = nil) {
+        lastNpElapsed = elapsed
+        lastNpRate = rate
+        lastNpWallTime = CFAbsoluteTimeGetCurrent()
+        if let reason {
+            immersiveLog("native.clock.write", [
+                "elapsed": fmtTime(elapsed),
+                "rate": rate,
+                "reason": reason,
+                "gen": npWriteGeneration,
+                "assetId": currentlyPlayingAssetId ?? "nil"
+            ])
+        }
+    }
