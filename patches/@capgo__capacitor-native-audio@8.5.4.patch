+    /// Unified immersive log — same prefix as JS (`[MANYU_IMMERSIVE]`). Filter Xcode with that token.
+    /// Events are `native.*`; JS emits `js.*`. Clock fields: player/visual/deltaVP/lastNp/npRate/npAge.
+    internal func immersiveLog(_ event: String, _ fields: [String: Any] = [:]) {
+        var parts: [String] = ["[MANYU_IMMERSIVE]", event]
+        for key in fields.keys.sorted() {
+            guard let value = fields[key] else { continue }
+            parts.append("\(key)=\(fmtLogValue(value))")
+        }
+        print(parts.joined(separator: " "))
+    }
+
+    internal func fmtTime(_ t: TimeInterval) -> String {
+        String(format: "%.4f", t)
+    }
+
+    internal func fmtLogValue(_ value: Any) -> String {
+        switch value {
+        case let v as String: return v
+        case let v as Bool: return v ? "true" : "false"
+        case let v as Int: return String(v)
+        case let v as UInt64: return String(v)
+        case let v as Double:
+            if v.rounded() == v && abs(v) < 1_000_000 { return String(Int(v)) }
+            return String(format: "%.4f", v)
+        case let v as TimeInterval:
+            return fmtTime(v)
+        default:
+            return String(describing: value)
+        }
+    }
+
+    /// Dump both clocks. deltaVP>0 means scrubber bar is ahead of AVAudioPlayer (pause flash risk if we wrote player).
+    internal func logClock(
+        _ event: String,
+        assetId: String,
+        player: TimeInterval,
+        duration: TimeInterval,
+        extra: [String: Any] = [:]
+    ) {
+        let visual = nowPlayingVisualElapsed(duration: duration, fallback: player)
+        let npAge = lastNpWallTime > 0 ? (CFAbsoluteTimeGetCurrent() - lastNpWallTime) : -1
+        var fields: [String: Any] = [
+            "assetId": assetId,
+            "player": fmtTime(player),
+            "visual": fmtTime(visual),
+            "deltaVP": String(format: "%+.4f", visual - player),
+            "lastNp": fmtTime(lastNpElapsed),
+            "npRate": lastNpRate,
+            "npAge": String(format: "%.3f", npAge),
+            "duration": fmtTime(duration),
+            "gen": npWriteGeneration
+        ]
+        if duration.isFinite && duration > 0 {
+            fields["playerPct"] = String(format: "%.1f", player / duration * 100)
+            fields["visualPct"] = String(format: "%.1f", visual / duration * 100)
+        }
+        // flashRisk: bar and player disagree enough that writing the wrong one would jump
+        fields["flashRisk"] = abs(visual - player) > 0.05
+        for (k, v) in extra {
+            fields[k] = v
+        }
+        immersiveLog(event, fields)
+    }
