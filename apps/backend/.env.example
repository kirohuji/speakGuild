# ====== Backend (NestJS) ======
# NestJS ConfigModule 自动加载此文件

# ── 应用 ──
PORT=3001
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# ── 数据库 ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manyu

# ── Better Auth ──
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=your-32-char-secret-here-change-me

# ── 腾讯云（COS/STT/SMS 共用密钥）──
TENCENT_SECRET_ID=your-secret-id
TENCENT_SECRET_KEY=your-secret-key
TENCENT_REGION=ap-guangzhou

# ── 腾讯云短信（SMS）──
TENCENT_SMS_APP_ID=1400xxxxxx
TENCENT_SMS_SIGN_NAME=你的签名
TENCENT_SMS_TEMPLATE_ID=1234567

# ── AI ──
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=deepseek

# ── STT ──
STT_PROVIDER=whisper
WHISPER_INFERENCE_URL=
WHISPER_MODEL=
WHISPER_LANGUAGE=en
WHISPER_TIMEOUT_MS=120000

# ── Redis / BullMQ 后台任务队列 ──
REDIS_URL=redis://:your-redis-password@127.0.0.1:6379

# ── TTS ──
MINIMAX_API_KEY=your-minimax-key
MINIMAX_GROUP_ID=your-minimax-group
MINIMAX_MODEL=speech-2.8-hd
MINIMAX_BASE_URL=https://api.minimaxi.com/v1/t2a_v2
TTS_PROVIDER=minimax
CARTESIA_API_KEY=
HUME_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer rc_webhook_lourd
REVENUECAT_PROJECT_ID=sk_rdjQbgbeTDuoCDQzJbkrymzyrdelv

# ── 稳定性监控 / 运营告警（不填则关闭）──
SENTRY_DSN=
OPS_SERVICE_NAME=manyu-backend
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_AUTHORIZATION=
OPS_ALERT_MIN_INTERVAL_SECONDS=300
OPS_CAPACITY_CHECK_CRON=0 15 9 * * *
OPS_DB_MAX_BYTES=0
OPS_FILE_ASSET_MAX_BYTES=0

# ── 微信（第三方登录/绑定）──
# 网页授权（Web OAuth）
WECHAT_CLIENT_ID=your-wechat-app-id
WECHAT_CLIENT_SECRET=your-wechat-app-secret
# 移动端 native（App 内微信 SDK 登录/绑定，优先使用）
WECHAT_NATIVE_APP_ID=your-wechat-app-id
WECHAT_NATIVE_APP_SECRET=your-wechat-app-secret

# ── Apple（Sign in with Apple：登录/绑定）──
# 原生 iOS 登录/绑定：idToken 验签 aud 优先用 APPLE_APP_BUNDLE_IDENTIFIER（= App Bundle ID，lourd.manyu.app）
# APPLE_CLIENT_ID 为 Web OAuth 授权码流程的 clientId（Service ID），APPLE_TEAM_ID / KEY_ID / PRIVATE_KEY 仅该流程需要
APPLE_CLIENT_ID=lourd.manyu.app.auth
APPLE_TEAM_ID=your-team-id
APPLE_KEY_ID=your-key-id
APPLE_PRIVATE_KEY=your-private-key
APPLE_APP_BUNDLE_IDENTIFIER=lourd.manyu.app
